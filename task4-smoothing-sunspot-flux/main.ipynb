   "source": [
    "import numpy as np\n",
    "from matplotlib import pyplot as plt\n",
    "from pathlib import Path"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "5e9fd140",
   "metadata": {},
   "outputs": [],
   "source": [
    "data_dir = Path(\"data\")\n",
    "\n",
    "# read data from txt file\n",
    "sunspot_year, sunspot_month, sunspot = np.loadtxt(data_dir / \"data_group7.txt\", unpack=True)\n",
    "sunspot_year = sunspot_year.astype(int)\n",
    "sunspot_month = sunspot_month.astype(int)\n",
    "\n",
    "sunspot_time = sunspot_year + (sunspot_month - 1) / 12"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "1476e10e",
   "metadata": {},
   "outputs": [
    {
     "data": {
