   "source": [
    "# choose alpha with the largest gain in both indicators: minimize the worse of the two relative indicators\n",
    "alpha_best = alpha_values[np.argmin(np.maximum(fb_dev / running_mean_dev, fb_var / running_mean_var))]\n",
    "\n",
    "f_exp_smoothed_points = exponential_smoothing(sunspot, alpha_best)\n",
    "b_exp_smoothed_points = run_backward_exp_smoothing(f_exp_smoothed_points, alpha_best)\n",
    "b_exp_smooth_dev, b_exp_smooth_var = find_smoothing_indicators(sunspot, b_exp_smoothed_points)\n",
    "print(f\"Forward-backward exponential smoothing, α = {alpha_best}: deviation indicator = {b_exp_smooth_dev:.1f}, variability indicator = {b_exp_smooth_var:.1f}\")\n",
    "\n",
    "# plot the monthly data, the 13-month running mean and forward-backward exponential smoothing\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "ax.scatter(sunspot_time, sunspot, s=6, color=\"blue\", label=\"Monthly mean sunspot number\")\n",
    "ax.plot(sunspot_time, sunspot_smoothed, linewidth=2, color=\"red\", label=\"13-month running mean\")\n",
    "ax.plot(sunspot_time, b_exp_smoothed_points, linewidth=2, color=\"green\", label=f\"Forward-backward exponential smoothing, α = {alpha_best}\")\n",
    "ax.set_title(\"Monthly mean sunspot number smoothed by running mean and forward-backward exponential smoothing\")\n",
    "ax.set_xlabel(\"Year\")\n",
    "ax.set_ylabel(\"Sunspot number\")\n",
    "ax.grid(True, color=\"black\", linewidth=0.3)\n",
    "ax.legend(frameon=False, markerscale=2, ncol=3, loc=\"upper center\", bbox_to_anchor=(0.5, -0.12))\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
