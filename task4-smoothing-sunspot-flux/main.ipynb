    "# find the indicatiors of smoothing performance (from assignment 3)\n",
    "def find_smoothing_indicators(measured, estimated):\n",
    "    deviation = np.sum((measured - estimated)**2)\n",
    "    variability = np.sum((estimated[2:] - 2*estimated[1:-1] + estimated[:-2])**2)\n",
    "\n",
    "    return deviation, variability\n",
    "\n",
    "# indicators for the 13-month running mean\n",
    "running_mean_dev, running_mean_var = find_smoothing_indicators(sunspot, sunspot_smoothed)\n",
    "print(f\"13-month running mean: deviation indicator = {running_mean_dev:.1f}, variability indicator = {running_mean_var:.1f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "08079764",
   "metadata": {},
   "outputs": [
    {
     "data": {
