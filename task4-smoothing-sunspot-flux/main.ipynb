    }
   ],
   "source": [
    "# apply a 13-month running mean \n",
    "def smooth(data, time):\n",
    "    n = len(time)\n",
    "    running_mean_13 = data.copy()\n",
    "\n",
    "    for i in range(6, n - 6):\n",
    "        mean = (data[i-6] + data[i+6]) / 24\n",
    "\n",
    "        for j in range(i-5, i+6):\n",
    "            mean += data[j] / 12\n",
    "\n",
    "        running_mean_13[i] = mean\n",
    "\n",
    "    return running_mean_13\n",
    "\n",
    "sunspot_smoothed = smooth(sunspot, sunspot_time)\n",
    "\n",
    "# plot the data\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "ax.scatter(sunspot_time, sunspot, s=6, color=\"blue\", label=\"Monthly mean sunspot number\")\n",
    "ax.plot(sunspot_time, sunspot_smoothed, linewidth=2, color=\"red\", label=\"13-month running mean\")\n",
    "ax.set_title(\"Monthly mean and smoothed sunspot number\")\n",
    "ax.set_xlabel(\"Year\")\n",
    "ax.set_ylabel(\"Sunspot number\")\n",
    "ax.grid(True, color=\"black\", linewidth=0.3)\n",
    "ax.legend(frameon=False, markerscale=2, ncol=2, loc=\"upper center\", bbox_to_anchor=(0.5, -0.12))\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
