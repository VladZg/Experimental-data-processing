   "source": [
    "# check the choice of the window size M by the RMSE between the smoothed and the true trajectory\n",
    "def get_rmse(estimated, true_traj):\n",
    "    return np.sqrt(np.mean((estimated - true_traj)**2))\n",
    "\n",
    "print(f\"RMSE of measurements: {get_rmse(measured_trajectory_sun_nap, true_trajectory_sun_nap):.2f} m\\n\")\n",
    "\n",
    "# RMSE for the window sizes tried on each plot above\n",
    "m_values_on_plots = [[300, 200, 100], [120, 110, 100], [100, 80, 60], [100, 90, 80, 70]]\n",
    "for plot_number, m_values in enumerate(m_values_on_plots, start=1):\n",
    "    rmse_values = [get_rmse(running_mean_smoothing(measured_trajectory_sun_nap, m), true_trajectory_sun_nap) for m in m_values]\n",
    "    best_m = m_values[np.argmin(rmse_values)]\n",
    "    print(f\"Plot {plot_number}: \" + \", \".join(f\"M = {m}: {r:.2f} m\" for m, r in zip(m_values, rmse_values)) + f\"  ->  best M = {best_m}\")\n",
    "\n",
    "# RMSE for all possible window sizes\n",
    "all_m_values = np.arange(1, n + 1)\n",
    "all_m_rmse = np.array([get_rmse(running_mean_smoothing(measured_trajectory_sun_nap, m), true_trajectory_sun_nap) for m in all_m_values])\n",
    "m_optimal_sun_nap = all_m_values[np.argmin(all_m_rmse)]\n",
    "print(f\"\\nOptimal window size over all M from 1 to {n}: M = {m_optimal_sun_nap}, RMSE = {all_m_rmse.min():.2f} m\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "ax.plot(all_m_values, all_m_rmse, color=\"deepskyblue\", linewidth=1.5, label=\"RMSE of Running Mean Smoothing\")\n",
    "ax.scatter(m_optimal_sun_nap, all_m_rmse.min(), color=\"red\", s=40, zorder=3, label=f\"Minimum: M = {m_optimal_sun_nap}, RMSE = {all_m_rmse.min():.2f} m\")\n",
    "ax.set_title(\"RMSE of Running Mean Smoothing vs Window Size M during the Sun-Nap Stroll\", pad=10)\n",
    "ax.set_xlabel(\"Window Size M\")\n",
    "ax.set_ylabel(\"RMSE, m\")\n",
    "ax.grid(True, color=\"black\", linewidth=0.3)\n",
    "ax.legend(frameon=True)\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
