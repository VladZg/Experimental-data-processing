   "source": [
    "# methodical error: the deviation from the true trajectory caused by the smoothing method itself,\n",
    "# i.e. the error that remains when the filter is applied to the noise-free true trajectory.\n",
    "# random error: the part of the measurement noise that passes through the filter.\n",
    "# both filters are linear, so: smoothed(z) - X = [smoothed(X) - X] + smoothed(eta)\n",
    "\n",
    "# running mean with a centered window, applicable to any array of points\n",
    "def run_running_mean(points, window_size):\n",
    "    half_window = (window_size - 1) // 2\n",
    "    smoothed_points = np.full(points.size, np.nan)\n",
    "    for i in range(half_window, points.size - half_window):\n",
    "        points_sum = 0\n",
    "        for k in range(i - half_window, i + half_window + 1):\n",
    "            points_sum += points[k]\n",
    "        smoothed_points[i] = points_sum / window_size\n",
    "    return smoothed_points\n",
    "\n",
    "# variance of an error, the points where running mean is not defined are skipped\n",
    "def get_error_variance(error):\n",
    "    return np.nanmean(error**2)\n",
    "\n",
    "measurement_noise_harsh = measured_trajectory_harsh - true_trajectory_harsh\n",
    "\n",
    "# empirical errors of running mean\n",
    "running_mean_methodical_error = run_running_mean(true_trajectory_harsh, m_rounded) - true_trajectory_harsh\n",
    "running_mean_random_error = run_running_mean(measurement_noise_harsh, m_rounded)\n",
    "running_mean_total_error = running_mean_traj_points - true_trajectory_harsh\n",
    "\n",
    "# empirical errors of exponential smoothing\n",
    "exponential_methodical_error = run_exponential_smoothing(true_trajectory_harsh, alpha_optimal_harsh) - true_trajectory_harsh\n",
    "exponential_random_error = exponential_smoothing_traj_points - run_exponential_smoothing(true_trajectory_harsh, alpha_optimal_harsh)\n",
    "exponential_total_error = exponential_smoothing_traj_points - true_trajectory_harsh\n",
    "\n",
    "# theoretical variances for the random walk model\n",
    "# running mean:          methodical = sigma_w^2 * (M^2 - 1) / (12 * M),                random = sigma_eta^2 / M\n",
    "# exponential smoothing: methodical = sigma_w^2 * (1 - alpha)^2 / (alpha * (2 - alpha)), random = sigma_eta^2 * alpha / (2 - alpha)\n",
    "running_mean_methodical_theory = VARIANCE_W_HARSH * (m_rounded**2 - 1) / (12 * m_rounded)\n",
    "running_mean_random_theory = VARIANCE_ETA_HARSH / m_rounded\n",
    "exponential_methodical_theory = VARIANCE_W_HARSH * (1 - alpha_optimal_harsh)**2 / (alpha_optimal_harsh * (2 - alpha_optimal_harsh))\n",
    "exponential_random_theory = VARIANCE_ETA_HARSH * alpha_optimal_harsh / (2 - alpha_optimal_harsh)\n",
    "\n",
    "print(f\"{'Error variance, m^2':<24}{'Running Mean, M = ' + str(m_rounded):>28}{'Exponential Smoothing':>28}\")\n",
    "print(f\"{'':<24}{'empirical':>14}{'theory':>14}{'empirical':>14}{'theory':>14}\")\n",
    "print(f\"{'Methodical':<24}{get_error_variance(running_mean_methodical_error):>14.1f}{running_mean_methodical_theory:>14.1f}\"\n",
    "      f\"{get_error_variance(exponential_methodical_error):>14.1f}{exponential_methodical_theory:>14.1f}\")\n",
    "print(f\"{'Random':<24}{get_error_variance(running_mean_random_error):>14.1f}{running_mean_random_theory:>14.1f}\"\n",
    "      f\"{get_error_variance(exponential_random_error):>14.1f}{exponential_random_theory:>14.1f}\")\n",
    "print(f\"{'Total':<24}{get_error_variance(running_mean_total_error):>14.1f}{running_mean_methodical_theory + running_mean_random_theory:>14.1f}\"\n",
    "      f\"{get_error_variance(exponential_total_error):>14.1f}{exponential_methodical_theory + exponential_random_theory:>14.1f}\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Methodical error (standard deviation): running mean = {np.sqrt(get_error_variance(running_mean_methodical_error)):.1f} m, \"\n",
    "      f\"exponential smoothing = {np.sqrt(get_error_variance(exponential_methodical_error)):.1f} m\")"
