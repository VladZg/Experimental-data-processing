    "# perform exponential smoothing using the determined coefficient alpha\n",
    "def run_exponential_smoothing(measurements, alpha):\n",
    "    smoothed_points = np.zeros(measurements.size)\n",
    "    smoothed_points[0] = measurements[0]\n",
    "    \n",
    "    for i in range(1, measurements.size):\n",
    "        smoothed_points[i] = smoothed_points[i - 1] + alpha * (measurements[i] - smoothed_points[i-1])\n",
    "    \n",
    "    return smoothed_points\n",
    "\n",
    "smoothed_trajectory_huge = run_exponential_smoothing(measured_trajectory_huge, alpha_optimal_estimated_3000)\n",
    "smoothed_trajectory_small = run_exponential_smoothing(measured_trajectory_small, alpha_optimal_estimated_300)\n",
    "\n",
    "# plot the results for measured, true and smoothed trajectories\n",
    "def plot_results(true_traj, measured_traj, smoothed_traj, alpha, title):\n",
    "    steps = np.arange(true_traj.size)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(12, 5))\n",
    "    ax.scatter(steps, measured_traj, color=\"red\", s=6, alpha=0.5, label=\"Measurements $z_i$\")\n",
    "    ax.plot(steps, true_traj, color=\"green\", linewidth=1.5, label=\"True Trajectory $X_i$\")\n",
    "    ax.plot(steps, smoothed_traj, color=\"deepskyblue\", linewidth=1.5, label=f\"Exponential Smoothing, $\\\\alpha$ = {alpha:.3f}\")\n",
    "    ax.set_title(title, pad=10)\n",
    "    ax.set_xlabel(\"Step Number i\")\n",
    "    ax.set_ylabel(\"Coordinate X, m\")\n",
    "    ax.grid(True, color=\"black\", linewidth=0.3)\n",
    "    ax.legend(\n",
    "            frameon=False, \n",
    "            markerscale=3, \n",
    "            ncol=3,  \n",
    "            loc=\"lower center\",\n",
    "            bbox_to_anchor=(0.5, -0.3)\n",
    "        )\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "plot_results(true_trajectory_small, measured_trajectory_small, smoothed_trajectory_small, alpha_optimal_estimated_300, \"Panda's Trajectory, 300 Points\")\n",
    "plot_results(true_trajectory_huge, measured_trajectory_huge, smoothed_trajectory_huge, alpha_optimal_estimated_3000, \"Panda's Trajectory, 3000 points\")"
   ]
