    "# identify noise variances sigma_w^2 and sigma_eta^2 for the measured trajectory\n",
    "def identify_noise_variances(measurements):\n",
    "    # residuals\n",
    "    nu = measurements[1:] - measurements[:-1]      # nu_i  = z_i - z_{i-1}\n",
    "    rho = measurements[2:] - measurements[:-2]     # rho_i = z_i - z_{i-2}\n",
    "\n",
    "    # mathematical expectations\n",
    "    E_nu2 = np.sum(nu**2) / (measurements.size - 1)\n",
    "    E_rho2 = np.sum(rho**2) / (measurements.size - 2)\n",
    "\n",
    "    # solve the system of equations 7,8 (slide 74)\n",
    "    sigma2_w = E_rho2 - E_nu2\n",
    "    sigma2_eta = (2 * E_nu2 - E_rho2) / 2\n",
    "\n",
    "    return sigma2_w, sigma2_eta\n",
    "\n",
    "# apply the function above to both trajectory sizes and compare the estimated variances with the true values\n",
    "for dataset_size, measured_points in [(\"3000 points\", measured_trajectory_huge), (\"300 points\", measured_trajectory_small)]:\n",
    "    variance_w_estimated, variance_eta_estimated = identify_noise_variances(measured_points)\n",
    "    \n",
    "    err_w = abs(variance_w_estimated - VARIANCE_W) / VARIANCE_W * 100\n",
    "    err_eta = abs(variance_eta_estimated - VARIANCE_ETA) / VARIANCE_ETA * 100\n",
    "\n",
    "    print(f\"{dataset_size}:\")\n",
    "    print(f\"Process Dynamics Variance: estimate = {variance_w_estimated:.3f}, true = {VARIANCE_W:.3f}, relative error = {err_w:.3f} %\")\n",
    "    print(f\"Measurement Variance: estimate = {err_eta:.3f}, true = {VARIANCE_ETA:.3f}, relative error = {err_eta:.3f} %\")\n",
    "    print(\"-\" * 88)"
   ]
  },
