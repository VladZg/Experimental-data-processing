    "# find the optimal smoothing coefficient for exponential smoothing\n",
    "def get_optimal_alpha(variance_w, variance_eta):\n",
    "    chi = variance_w / variance_eta\n",
    "    return (-chi + np.sqrt(chi**2 + 4 * chi)) / 2\n",
    "\n",
    "alpha_optimal_true = get_optimal_alpha(VARIANCE_W, VARIANCE_ETA)\n",
    "\n",
    "variance_w_estimated_3000, variance_eta_estimated_3000 = identify_noise_variances(measured_trajectory_huge)\n",
    "alpha_optimal_estimated_3000 = get_optimal_alpha(variance_w_estimated_3000, variance_eta_estimated_3000)\n",
    "\n",
    "variance_w_estimated_300, variance_eta_estimated_300 = identify_noise_variances(measured_trajectory_small)\n",
    "alpha_optimal_estimated_300 = get_optimal_alpha(variance_w_estimated_300, variance_eta_estimated_300)\n",
    "\n",
    "print(f\"optimal alpha (true variances):      {alpha_optimal_true:.3f}\")\n",
    "print(f\"optimal alpha (estimated variances, 3000 points): {alpha_optimal_estimated_3000:.3f}\")\n",
    "print(f\"optimal alpha (estimated variances, 300 points): {alpha_optimal_estimated_300:.3f}\")"
   ]
  },
